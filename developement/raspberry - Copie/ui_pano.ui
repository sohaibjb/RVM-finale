#text_p , #text_c {font: 25 20pt &quot;Piboto Condensed&quot;;}
#text_total_numb{font: 15 16pt &quot;Piboto Condensed&quot;;}

#level_c , #level_p{
	border: 1px solid grey;
	border-radius: 2px;
	}
#level_p::chunk , #level_c::chunk{
background-color: rgb(0, 255, 0);
width: 8px;
}

