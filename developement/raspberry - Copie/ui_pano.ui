      <property name="styleSheet">
       <string notr="true">#page_content {background-image:url(:/background_img/images/images/bg.png);
background-color:black;
background-origin: cover;
background-clip: padding;
background-position: center;
background-repeat: no-repeat;}

#text_p , #text_c {color:white}
#number_c, #number_p , #total_number ,#text_total_numb ,#text_u1 ,#number_un,#text_u2,#time_1 {color:#737373;}

#btn_echanger , #butt_help{color:#737373;}

#btn_echanger, #total_number{border-radius: 55px;border: 2px solid #666;}
#butt_help {border-radius: 20px;border: 2px solid #666;font: 25 20pt &quot;Piboto Condensed&quot;}

#btn_echanger:hover , #butt_help:hover ,#btn_echanger:pressed , #butt_help:pressed {
background-color:qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 rgba(0, 0, 0, 0), stop:0.306818 rgba(0, 0, 0, 5), stop:0.653409 rgba(0, 0, 0, 14), stop:0.926136 rgba(0, 0, 0, 30))
}

#number_p{font: 45pt &quot;Piboto Condensed&quot;;}
