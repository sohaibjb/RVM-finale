   <property name="styleSheet">
    <string notr="true">/*////////////////////////// Counting page /////////////////////////////*/
#counting_page {background-image:url(:/images/images/images/menu.png);
background-color:black;
background-origin: cover;
background-clip: padding;
background-position: center;
background-repeat: no-repeat;}

#btn_help {border-radius: 20px;border: 2px solid #666;font: 25 20pt &quot;Piboto Condensed&quot; ;color:#737373;}

#level_c , #level_p{
backgroundcolor:rgba(0,0,0,0);
border: 1px solid grey;
border-radius: 2px;
}
#level_p::chunk , #level_c::chunk{
background-color: rgb(0, 255, 0);
width: 8px;
}

#number_c, #number_p {color:#737373;}
#number_p , #number_c{font: 45pt &quot;Piboto Condensed&quot;;}

#number_un{color:#737373;font: 25 15pt&quot;Piboto Condensed&quot;;}

#text_p , #text_c {color:white ;font: 25 20pt &quot;Piboto Condensed&quot;;}
#text_total_numb {color:#737373;font: 15 16pt &quot;Piboto Condensed&quot;;}

#text_u1 ,#text_u2 {color:#737373;font: 25 10pt &quot;Piboto Condensed&quot;;}
#text_u1 ,#number_un,#text_u2 {color:rgb(103, 103, 103);}


#time_1 {color:#737373;}

#total_number{color:#737373;
border-radius: 50px;
border: 2px solid #666
;border-radius: 55px;
border: 2px solid #666
;font: 25 40pt &quot;Piboto Condensed&quot;;
}

#btn_help:hover ,#btn_help:pressed {
background-color:qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 rgba(0, 0, 0, 0), stop:0.306818 rgba(0, 0, 0, 5), stop:0.653409 rgba(0, 0, 0, 14), stop:0.926136 rgba(0, 0, 0, 30))
}

#btn_scanqr , #btn_printer , #btn_donate {border: 0px solid #666;}
#lbl_donate ,#lbl_printer ,#lbl_scanqr {color:rgb(62, 62, 62); font:20 14pt &quot;Piboto Condensed&quot;;
}

#optionstitle{color:rgb(62, 62, 62); font:20 17pt &quot;Piboto Condensed&quot;;}</string>
